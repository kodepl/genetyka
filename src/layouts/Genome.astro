---
import site from "../site.config";
import { rubricSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Start" },
  { href: "/blog/", label: "Artykuły" },
  { href: "/dzialy/", label: "Działy" },
  { href: "/slownik/", label: "Słownik" },
  { href: "/pytania/", label: "Pytania" },
  { href: "/o-nas/", label: "O nas" },
  { href: "/kontakt/", label: "Kontakt" },
];
function current(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
const orgLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: `https://www.${site.domain}/`,
  description: site.tagline,
  inLanguage: "pl-PL",
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: `https://www.${site.domain}/`,
    email: site.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: "ul. Królewska 18, lok. 4",
      addressLocality: site.city,
      postalCode: "00-103",
      addressCountry: "PL",
    },
  },
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.includes(site.name) ? title : `${title} · ${site.name}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title.includes(site.name) ? title : `${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --ink: #062a28;
        --paper: #f3f7f4;
        --panel: #ffffff;
        --accent: #0d6b5c;
        --accent-soft: #d7efe8;
        --line: rgba(6, 42, 40, 0.12);
        --muted: rgba(6, 42, 40, 0.68);
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: "Source Sans 3", system-ui, sans-serif;
        background:
          radial-gradient(1200px 480px at 8% -10%, rgba(13, 107, 92, 0.12), transparent 55%),
          radial-gradient(900px 420px at 92% 0%, rgba(4, 47, 46, 0.08), transparent 50%),
          linear-gradient(180deg, #eaf3ef 0%, var(--paper) 28%, #eef4f0 100%);
        color: var(--ink);
        min-height: 100vh;
      }
      .font-serif { font-family: "Fraunces", Georgia, serif; }
      .genome-shell {
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--panel) 92%, #d7efe8);
        box-shadow: 0 1px 0 rgba(255,255,255,0.7) inset;
      }
      .genome-prose :where(a) { color: var(--accent); }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { animation: none !important; transition: none !important; }
      }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(orgLd).replace(/</g, "\\u003c")} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    )}
  </head>
  <body class="bg-genome-50 text-genome-950">
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-3 focus:py-2" href="#tresc">Przejdź do treści</a>
    <header class="border-b border-genome-800/20 bg-genome-950 text-genome-50">
      <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-5 py-6">
        <div>
          <a href="/" class="font-serif text-3xl font-semibold tracking-tight text-genome-100">{site.name}</a>
          <p class="mt-1 max-w-lg text-sm text-genome-100/70">{site.tagline}</p>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-genome-100/85" aria-label="Główne">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={["hover:text-white", current(item.href) && "text-white underline decoration-genome-100/40 underline-offset-4"]}
              aria-current={current(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div id="tresc">
      <slot />
    </div>
    <footer class="mt-16 border-t border-genome-800/15 bg-genome-950 text-genome-100/75">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 text-sm md:grid-cols-3">
        <div>
          <p class="font-serif text-lg font-semibold text-genome-50">{site.name}</p>
          <p class="mt-2">{site.tagline}</p>
          <p class="mt-3">{site.address}</p>
          <p class="mt-2"><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <p class="font-semibold text-genome-50">Działy</p>
          <ul class="mt-3 space-y-2">
            {site.rubrics.map((r) => (
              <li><a class="hover:text-white" href={`/dzialy/${rubricSlug(r.name)}/`}>{r.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-semibold text-genome-50">Narzędzia i informacja</p>
          <ul class="mt-3 space-y-2">
            <li><a class="hover:text-white" href="/slownik/">Słownik pojęć</a></li>
            <li><a class="hover:text-white" href="/pytania/">Pytania do poradni</a></li>
            <li><a class="hover:text-white" href="/polityka-prywatnosci/">Polityka prywatności</a></li>
            <li><a class="hover:text-white" href="/regulamin/">Regulamin</a></li>
          </ul>
          <p class="mt-4 leading-relaxed">Materiały mają charakter edukacyjny. Nie zastępują konsultacji genetycznej ani porady lekarskiej.</p>
          <p class="mt-3 text-xs">© {new Date().getFullYear()} {site.name}, {site.city}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"PLACEHOLDER_ANALYTICS"}'></script>
  </body>
</html>
