---
import Genome from "../layouts/Genome.astro";
import { getCollection } from "astro:content";
import site, { coverFor, rubricSlug } from "../site.config";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts[0];
const rest = posts.slice(1, 7);
const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];
---
<Genome title={site.name} description={site.tagline} image={site.heroImage}>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-[1fr_300px]">
    <section>
      {lead && (
        <a href={`/blog/${lead.slug}/`} class="group block overflow-hidden rounded-sm border border-genome-800/10 bg-white shadow-sm">
          <img src={coverFor(lead.data.category, lead.data.image)} alt="" class="h-72 w-full object-cover transition group-hover:opacity-95" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-genome-700">{lead.data.category}</p>
            <h1 class="mt-2 font-serif text-4xl font-semibold leading-tight text-genome-950">{lead.data.title}</h1>
            <p class="mt-3 text-genome-800/80">{lead.data.description}</p>
          </div>
        </a>
      )}
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {rest.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group block overflow-hidden rounded-sm border border-genome-800/10 bg-white shadow-sm">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-36 w-full object-cover" />
            <div class="p-4">
              <p class="text-xs uppercase tracking-wide text-genome-700">{post.data.category}</p>
              <h2 class="mt-1 font-serif text-xl font-semibold leading-snug group-hover:text-genome-700">{post.data.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </section>
    <aside class="h-fit space-y-6 rounded-sm border border-genome-800/10 bg-white p-5 shadow-sm">
      <div>
        <h2 class="font-serif text-lg font-semibold text-genome-900">Z laboratorium na stół</h2>
        <p class="mt-2 text-sm leading-relaxed text-genome-800/75">
          Piszemy o wynikach badań, które rodziny dostają na papierze — z liczbami, przykładami z kliniki i bez obietnic cudów.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-lg font-semibold text-genome-900">Działy</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {cats.length > 0
            ? cats.map((cat) => (
                <li><a class="text-genome-800 hover:text-genome-600" href={`/dzialy/${rubricSlug(cat)}/`}>{cat}</a></li>
              ))
            : site.rubrics.map((r) => (
                <li><a class="text-genome-800 hover:text-genome-600" href={`/dzialy/${rubricSlug(r.name)}/`}>{r.name}</a></li>
              ))}
        </ul>
      </div>
      <div class="flex gap-3 border-t border-genome-800/10 pt-5">
        <img src={site.authorAvatar} alt={site.author} class="h-14 w-14 rounded-full object-cover ring-2 ring-genome-700/20" />
        <div>
          <p class="font-medium text-genome-950">{site.author}</p>
          <p class="text-xs text-genome-700">{site.authorRole}, {site.city}</p>
        </div>
      </div>
      <a href="/blog/" class="inline-block text-sm font-medium text-genome-700 underline decoration-genome-600/40 hover:text-genome-600">Wszystkie artykuły</a>
    </aside>
  </div>
</Genome>
