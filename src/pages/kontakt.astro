---
import EmailLink from "../components/EmailLink.astro";
import Genome from "../layouts/Genome.astro";
import site from "../site.config";
---
<Genome title="Kontakt" description={`Kontakt z redakcją ${site.name}.`}>
  <section class="mx-auto max-w-xl px-5 py-10">
    <h1 class="font-serif text-4xl font-semibold text-genome-950">Kontakt</h1>
    <p class="mt-4 text-genome-800/80">Redakcja {site.name}</p>
    <p class="mt-2">{site.address}</p>
    <p class="mt-2"><EmailLink /></p>
    <p class="mt-6 text-sm leading-relaxed text-genome-800/70">
      Odpowiadamy na pytania redakcyjne i propozycje tematów. Nie udzielamy porad medycznych przez e-mail — w takich sprawach prosimy o kontakt z lekarzem lub poradnią genetyczną.
    </p>
    </section>
</Genome>
