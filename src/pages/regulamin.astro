---
import Genome from "../layouts/Genome.astro";
import site from "../site.config";
---
<Genome title="Regulamin">
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-serif text-3xl font-semibold text-genome-950">Regulamin</h1>
    <p class="mt-6 leading-relaxed text-genome-800/80">
      Korzystając z serwisu https://www.genetyka.com.pl akceptujesz zasady publikacji materiałów redakcyjnych {site.name}. Treści mają charakter edukacyjny i informacyjny — nie stanowią porady medycznej, diagnozy ani rekomendacji terapeutycznej.
    </p>
    <p class="mt-4 leading-relaxed text-genome-800/80">
      Decyzje dotyczące badań genetycznych i leczenia należy podejmować wyłącznie po konsultacji z lekarzem lub genetykiem klinicznym. Kontakt: {site.email}.
    </p>
  </section>
</Genome>
